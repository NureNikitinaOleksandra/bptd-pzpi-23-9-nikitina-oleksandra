	1.2.1.1 BitHelper.cs
	Оскільки стандарт DES специфікований на рівні окремих бітів, а базові типи даних у мові C# оперують мінімум байтами (8 бітів), для роботи алгоритму знадобився окремий утилітарний клас. Щоб не прописувати складні побітові зсуви та накладання масок у кожному кроці мережі Фейстеля, я винесла всю цю логіку в статичний клас BitHelper.
	Він перетворює байти на BitArray і назад (методи ToBits та ToBytes), виконує перестановки за заданими таблицями (Permute), XOR (Xor), розділення та об’єднання лівої й правої половин (Split, Concat), циклічний зсув (RotateLeft) і конвертацію HEX (ToHex, FromHex).
	Щоб програма могла шифрувати тексти будь-якої довжини (наприклад, повідомлення з 10 байтів), я реалізувала стандарт доповнення PKCS#7 через методи розширення AddPkcs7Padding та RemovePkcs7Padding. Якщо довжина відкритого тексту не кратна 8, алгоритм автоматично додає від 1 до 8 відсутніх байтів. При цьому кожен доданий байт містить значення, що дорівнює кількості доданих байтів (наприклад, додається три байти зі значенням 0x03).
public static class ByteArrayExtensions
{
    // Доповнює дані до кратності 8 байтам.
    public static byte[] AddPkcs7Padding(this byte[] input)
    {
        if (input == null) throw new ArgumentNullException(nameof(input));

        int padLength = 8 - (input.Length % 8);
        var padded = new byte[input.Length + padLength];
        Array.Copy(input, padded, input.Length);

        // Записуємо значення, яке дорівнює кількості доданих байтів.
        for (int i = input.Length; i < padded.Length; i++)
        {
            padded[i] = (byte)padLength;
        }
        return padded;
    }

    // Зняття доповнення після розшифрування
    public static byte[] RemovePkcs7Padding(this byte[] bytes)
    {
        if (bytes == null || bytes.Length == 0 || bytes.Length % 8 != 0)
            throw new ArgumentException("Некоректна довжина даних для зняття PKCS#7.");

        int padLength = bytes[bytes.Length - 1];

        if (padLength < 1 || padLength > 8)
            throw new ArgumentException("Некоректне значення доповнення PKCS#7. Дані пошкоджені або використано неправильний ключ.");

        for (int i = bytes.Length - padLength; i < bytes.Length; i++)
        {
            if (bytes[i] != padLength)
                throw new ArgumentException("Помилка цілісності PKCS#7 доповнення. Розшифровані байти не відповідають стандарту.");
        }

        return bytes.Take(bytes.Length - padLength).ToArray();
    }
}

	Таблиці DES нумерують позиції бітів, починаючи з 1, а індекси масиву C# починаються з 0. Тому в Permute використовується table[i] – 1:
public static BitArray Permute(BitArray input, int[] table)
{
    if (input == null) throw new ArgumentNullException(nameof(input));
    if (table == null) throw new ArgumentNullException(nameof(table));

    var output = new BitArray(table.Length);
    for (int i = 0; i < table.Length; i++)
    {
        int sourceIndex = table[i] - 1;
        if (sourceIndex < 0 || sourceIndex >= input.Length)
            throw new ArgumentException("Некоректна таблиця перестановки.");
        output[i] = input[sourceIndex];
    }
    return output;
}

	1.2.1.2 DesTables.cs
Цей клас містить сталі таблиці DES: початкову та фінальну перестановки, розширення E, перестановку P, таблиці PC-1 і PC-2, графік циклічних зсувів і всі вісім S-блоків. Там же зберігається список слабких ключів, які реалізація відхиляє. Я винесла ці значення в окремий клас, щоб не захаращувати основний алгоритм великими таблицями й простіше перевіряти їх окремо.

	1.2.1.3 KeySchedule.cs
	Цей клас створює 16 раундових ключів. Спочатку перевіряється, що вихідний ключ має 8 байтів, а також що він не входить до списку слабких ключів. PC-1 перетворює 64 біти на 56 ефективних. Потім ключ ділиться на дві половини C і D по 28 бітів. У кожному раунді половини циклічно зсуваються на одну або дві позиції, після чого PC-2 вибирає 48 бітів для раундового ключа.
	Тобто на вході маємо один ключ, а всередині DES використовуються шістнадцять різних 48-бітних ключів. Для дешифрування повторно генерувати інший набір не потрібно: використовуються ті самі ключі, тільки у зворотному порядку.
public sealed class KeySchedule
{
    public List<BitArray> GenerateKeys(byte[] key)
    {
        if (key.Length != 8)
            throw new ArgumentException("Ключ DES повинен містити рівно 8 байтів.");

        string keyHex = BitHelper.ToHex(key);
        if (DesTables.WeakKeys.Contains(keyHex, StringComparer.OrdinalIgnoreCase))
            throw new ArgumentException("Використано слабкий ключ DES. Оберіть інший ключ.");

        var effectiveKey = BitHelper.Permute(BitHelper.ToBits(key), DesTables.PC_1);


        var (c, d) = BitHelper.Split(effectiveKey);

        var keys = new List<BitArray>(16);

        for (int round = 0; round < 16; round++)
        {
            int shifts = DesTables.ShiftSchedule[round];

            c = BitHelper.RotateLeft(c, shifts);
            d = BitHelper.RotateLeft(d, shifts);

            var combined = BitHelper.Concat(c, d);

            keys.Add(BitHelper.Permute(combined, DesTables.PC_2));
        }

        return keys;
    }
}

	1.2.1.4 FeistelNetwork.cs
	Цей клас виконує раундову функцію f, яка безпосередньо відповідає за сплутування та розсіювання даних. Права половина має 32 біти. Спочатку E розширює її до 48 бітів, потім виконується XOR із 48-бітним раундовим ключем. Результат проходить через вісім S-блоків: кожен приймає 6 бітів і повертає 4, тому разом знову виходить 32 біти. Після цього застосовується перестановка P.
	S-блоки – одна з головних нелінійних частин DES. Саме вони допомагають алгоритму не зводитися до простого набору перестановок і XOR.
public sealed class FeistelNetwork
{
    public BitArray RoundFunction(BitArray rightHalf, BitArray roundKey)
    {
        if (rightHalf.Length != 32 || roundKey.Length != 48)
            throw new ArgumentException("Очікуються R = 32 біти та ключ = 48 бітів.");

        var expanded = Expand(rightHalf);

        var mixed = BitHelper.Xor(expanded, roundKey);

        var substituted = ApplySBoxes(mixed);

        return Permute(substituted);
    }

    private BitArray Expand(BitArray input)
    {
        if (input.Length != 32)
            throw new ArgumentException("E-розширення приймає 32 біти.");

        return BitHelper.Permute(input, DesTables.E);
    }

    private BitArray ApplySBoxes(BitArray input)
    {
        if (input.Length != 48)
            throw new ArgumentException("S-блоки приймають 48 бітів.");

        var output = new BitArray(32);

        for (int box = 0; box < 8; box++)
        {
            int offset = box * 6; // Вказівник на початок поточної 6-бітної групи.

            int row = (input[offset] ? 2 : 0)
                    | (input[offset + 5] ? 1 : 0);

            int column = 0;
            for (int j = 1; j <= 4; j++)
                column = (column << 1) | (input[offset + j] ? 1 : 0);

            int value = DesTables.S_BOX[box][row][column];

            for (int bit = 0; bit < 4; bit++)
                output[box * 4 + bit] =
                    (value & (1 << (3 - bit))) != 0;
        }

        return output;
    }

    private BitArray Permute(BitArray input) =>
        BitHelper.Permute(input, DesTables.P);
}

	1.2.1.5 DesCipher.cs
	Це основний клас, який організовує шифрування та дешифрування. Спочатку застосовується IP, після чого 64-бітний блок ділиться на ліву й праву половини по 32 біти. На кожному раунді виконується правило мережі Фейстеля:
L(i) = R(i-1)
R(i) = L(i-1) XOR f(R(i-1), K(i))
	Після кожного раунду код зберігає ліву та праву половини у HEX і записує ентропію стану. Після шістнадцятого раунду половини з’єднуються у зворотному порядку R16||L16 і застосовується IP⁻¹. Transform обробляє масив, що складається з цілої кількості 8-байтових блоків. 

	1.2.1.6 EntropyCalculator.cs
	Для виконання вимоги щодо перевірки якості роботи алгоритму та розрахунку ентропії після кожного раунду, я створила окремий аналітичний модуль – EntropyCalculator. Його головне завдання полягає в тому, щоб продемонструвати, як алгоритм DES поступово приховує закономірності відкритого тексту, наближаючи співвідношення нулів та одиниць у блоці до ідеальної рівноваги.
	В основі класу лежить класична формула інформаційної ентропії Шеннона для бінарної системи:
H = - (p_0  ×log_2⁡〖p_0 〗+ p_1  ×log_2⁡〖p_1 〗)
де p_0 та p_1— ймовірності появи нуля та одиниці у поточному 64-бітному блоці.
public sealed class EntropyCalculator
{
    // Список для збереження історії ентропії.
    public List<double> RoundEntropies { get; } = new();

    // Головний метод обчислення. Приймає поточний стан блоку (L + R) = 8 байтів.
    public double CalculateAndStoreEntropy(byte[] currentData)
    {
        // Перевіряємо, чи точно передали 64 біти (8 байтів).
        if (currentData.Length != 8)
            throw new ArgumentException("Потрібен блок розміром 64 біти.");

        // Конвертуємо байти в біти.
        BitArray bits = BitHelper.ToBits(currentData);

        // Рахуємо кількість одиниць у блоці.
        int ones = 0;
        for (int i = 0; i < bits.Length; i++)
            if (bits[i])
                ones++;

        // Обчислюємо ймовірність появи одиниці (p1) та нуля (p0).
        double p1 = ones / (double)bits.Length;
        double p0 = 1.0 - p1;

        double entropy = 0;

        // Застосовуємо формулу Шеннона.
        if (p0 > 0)
            entropy -= p0 * Math.Log2(p0);

        if (p1 > 0)
            entropy -= p1 * Math.Log2(p1);

        // Зберігаємо поточне значення в історію та повертаємо його.
        RoundEntropies.Add(entropy);
        return entropy;
    }
}

